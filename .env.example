# RFQ Tracker Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=rfq-traceability-secret-key-enterprise-2026-secure
DATABASE_URL=sqlite:///rfq_tracker.db
PORT=5000
# Safe default: never send email. log marks messages previewed without sending.
EMAIL_MODE=disabled
# Set only after the company agrees which priorities are "major".
# Example (not a company rule): High,Critical
MAJOR_RFQ_PRIORITIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10
NOTIFICATION_INTERVAL=300
